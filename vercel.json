{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/stewordle", "destination": "/stewordle/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/griddy", "destination": "/griddy/client/build/index.html" },
    { "source": "/griddy/:path*", "destination": "/griddy/client/build/:path*" }
  ]
}
